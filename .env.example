# ── Server ────────────────────────────────────────────────────
PORT=5000
NODE_ENV=development

# ── MongoDB ───────────────────────────────────────────────────
# Local:  mongodb://localhost:27017/habit_tracker
# Atlas:  mongodb+srv://<user>:<pass>@cluster0.xxxxx.mongodb.net/habit_tracker
MONGO_URI=mongodb://localhost:27017/habit_tracker

# ── JWT ───────────────────────────────────────────────────────
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=your_super_secret_jwt_key_change_this_in_production
JWT_EXPIRES_IN=7d
JWT_REFRESH_EXPIRES_IN=30d

# ── Rate limiting ─────────────────────────────────────────────
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100

# ── CORS origins (comma-separated) ───────────────────────────
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,https://yourdomain.github.io
